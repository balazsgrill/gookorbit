# Server Core
PORT=8080
LOG_LEVEL=info
BASE_URL=http://192.168.1.100:8080

# Database
DATABASE_URL=postgres://gookorbit:secret@localhost:5432/gookorbit?sslmode=disable

# Bootstrap: the single bearer token authenticating the admin user.
# Required. Generated on first use, e.g.: openssl rand -hex 24
GOORBIT_BOOTSTRAP_TOKEN=change-me

# S3 Object Storage
S3_ENDPOINT=minio.homelab.local:9000
S3_REGION=us-east-1
S3_BUCKET=gookorbit-library
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
# true = device downloads 302-redirect to presigned S3 URLs
STORAGE_PRESIGN=false
